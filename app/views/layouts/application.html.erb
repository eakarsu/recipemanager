<!DOCTYPE html>
<html>
<head>
  <title>My Recipies</title>
  <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track' => true %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
  <%= csrf_meta_tags %>
<style>
.codex-rails-shell{display:grid;grid-template-columns:240px minmax(0,1fr);gap:20px;max-width:1500px;margin:0 auto;padding:16px}.codex-rails-main{min-width:0}
.codex-rails-sidebar{position:sticky;top:16px;align-self:start;height:calc(100vh - 32px);overflow:auto;padding:18px 12px;border-radius:12px;background:#0b1220;color:#f8fafc;border:1px solid #26364d}
.codex-rails-sidebar strong{display:block;font-size:16px;line-height:1.3;padding:8px 10px 16px;border-bottom:1px solid #334155}.codex-rails-sidebar nav{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:2px!important;padding-top:12px}
.codex-rails-sidebar nav a{display:block!important;color:#cbd5e1!important;text-decoration:none!important;padding:9px 11px!important;border-radius:8px;font-size:13px;font-weight:600;line-height:1.3}.codex-rails-sidebar nav a:hover,.codex-rails-sidebar nav a:focus-visible{background:#1e293b;color:#fff!important}
@media(max-width:800px){.codex-rails-shell{grid-template-columns:minmax(0,1fr)}.codex-rails-sidebar{position:relative;height:auto;max-height:280px}}
</style>
</head>
<body>
  <%=render 'layouts/navigation' %>
  
  <div class="codex-rails-shell"><aside class="codex-rails-sidebar" aria-label="Application navigation"><strong>Recipe Manager</strong><nav aria-label="Sections">
<%= link_to "Home", root_path %>
<%= link_to "Recipes", recipes_path %>
<%= link_to "Chefs", chefs_path %>
<% if logged_in? %>
<%= link_to "New Recipe", new_recipe_path %>
<%= link_to "My Profile", chef_path(current_user) %>
<% else %>
<%= link_to "Sign In", login_path %>
<% end %>
</nav></aside><div class="codex-rails-main container">
    <%= render 'layouts/messages' %>
    <%= yield %>
    <%= render 'layouts/footer' %>
  </div></div>


</body>
</html>
